# ==============================================================================
# EdgePulse Deploy — Environment Configuration Template
# Copy to `.env.local` for local overrides, or run `vercel env pull .env.local`
# ==============================================================================

# Public Browser-Safe Configuration (inlined at build time)
NEXT_PUBLIC_APP_NAME="EdgePulse Deploy"
NEXT_PUBLIC_DEPLOYMENT_CHANNEL="canary-observability"

# Server-Only Secrets (NEVER prefix with NEXT_PUBLIC_)
# Required in Production/Preview to authorize POST /api/revalidate cache purges.
# In local development, falls back to "local-demo-secret" when unset.
REVALIDATE_SECRET="replace-with-32-byte-hex-revalidate-secret"

# Required to access protected /status/admin route gated by Edge Middleware.
# Pass via `x-edgepulse-admin-token` header or `?token=` query in non-prod.
EDGEPULSE_ADMIN_TOKEN="replace-with-admin-inspector-token"

# Optional Telemetry / Observability Sink
OBSERVABILITY_WEBHOOK_URL=""
LOG_SAMPLING_RATE="1.0"

# ==============================================================================
# Vercel System Environment Variables (Auto-injected on Vercel Deployments)
# Leave unset locally to test local fallback behavior:
#   VERCEL_ENV=development | preview | production
#   VERCEL_REGION=iad1
#   VERCEL_GIT_COMMIT_SHA=<40-char-sha>
#   VERCEL_GIT_COMMIT_REF=main
#   VERCEL_URL=<deployment-url>
# ==============================================================================
